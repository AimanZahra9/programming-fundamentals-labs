#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

int main() {
    // random numbers ke liye
    srand(time(0));
    
    int num1 = rand() % 900 + 100; // 100 se 999 tak 3-digit number
    int num2 = rand() % 900 + 100;
    
    int answer = num1 + num2;

    cout << "  " << num1 << endl;
    cout << "+ " << num2 << endl;
    cout << "-------" << endl;

    cout << "\nSolve the problem and press Enter to see answer...";
    cin.get(); // pause

    cout << "\n  " << num1 << endl;
    cout << "+ " << num2 << endl;
    cout << "-------" << endl;
    cout << "  " << answer << endl;

    return 0;
}